{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "tests", "eval", "e2e", "vite.config.ts", "playwright.config.ts"]
}
